{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen4Stream",
  "version": "0.1.0",
  "identifier": "com.screen4stream.app",
  "build": {
    "frontendDist": "http://127.0.0.1:8080",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
